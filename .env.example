# Settings for docker compose (copy to .env). The backend's own settings for
# running without Docker live in backend/.env.example.

# Required: secret for signing login tokens. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Optional
POSTGRES_PASSWORD=backtester
API_PORT=8000
WEB_PORT=8080
# Where the browser reaches the API, and the web app's origin (for CORS).
PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:8080
BACKTEST_WORKERS=2
