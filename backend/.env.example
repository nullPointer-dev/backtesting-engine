# PostgreSQL connection string used by the API, the data loader and Alembic.
DB_URL=postgresql://postgres:postgres@localhost:5432/backtesting_engine

# Separate database used by the API/integration tests (it gets wiped).
TEST_DB_URL=postgresql://postgres:postgres@localhost:5432/backtesting_engine_test

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Optional
SQL_ECHO=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Worker processes for running backtests; 0 runs them inside the API process.
BACKTEST_WORKERS=2
